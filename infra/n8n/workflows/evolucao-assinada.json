      "position": [480, -240],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "resource": "fileFolder",
        "operation": "search",
        "searchMethod": "query",
        "queryString": "={{ \"appProperties has { key='agenda_evento_id' and value='\" + $json.evento_id + \"' } and trashed = false\" }}",
        "returnAll": false,
        "limit": 2,
        "filter": {"driveId": {"mode": "list", "value": "My Drive"}, "folderId": {"mode": "url", "value": "CONFIGURAR_URL_PASTA_DRIVE"}, "whatToSearch": "files", "includeTrashed": false},
        "options": {"fields": ["*"]}
      },
      "id": "22d3b39e-f8d6-4a57-a5ac-7679ec8f0013",
      "name": "Buscar PDF existente",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [720, -240],
      "alwaysOutputData": true,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const gerado = $('Gerar PDF').first();\nconst encontrados = $input.all().filter((item) => item.json && item.json.id);\nif (encontrados.length > 1) throw new Error('drive_idempotencia_duplicada');\nif (encontrados.length === 1) {\n  const arquivo = encontrados[0].json;\n  if (!arquivo.appProperties || arquivo.appProperties.agenda_pdf_sha256 !== gerado.json.pdf_sha256) throw new Error('drive_hash_divergente');\n  return [{ json: { ...gerado.json, arquivo_existente: true, drive_file_id: arquivo.id } }];\n}\nreturn [{ json: { ...gerado.json, arquivo_existente: false }, binary: gerado.binary }];"
      },
