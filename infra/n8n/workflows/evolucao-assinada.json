    {
      "parameters": {
        "jsCode": "const { gerarPdf } = require('@agenda/pdf-evolucao');\nconst atual = $('Validar HMAC e janela').first().json;\nconst resultado = await gerarPdf(atual.payload);\nreturn [{ json: { evento_id: atual.evento_id, payload_sha256: atual.payload_sha256, pdf_sha256: resultado.sha256 }, binary: { data: { data: resultado.buffer.toString('base64'), mimeType: resultado.mimeType, fileName: resultado.fileName, fileExtension: 'pdf' } } }];"
      },
      "id": "22d3b39e-f8d6-4a57-a5ac-7679ec8f0012",
