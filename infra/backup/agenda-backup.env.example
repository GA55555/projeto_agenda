# Copiar para /etc/agenda-backup/agenda-backup.env no servidor e aplicar chmod 600.
# Este arquivo nao pode entrar no Git: contem caminhos operacionais e aponta para segredos.

# Diretorio que E o ponto de montagem de um filesystem cifrado (ex.: LUKS+ext4 ou
# gocryptfs). O script recusa um diretorio comum, mesmo que esteja no HDD.
BACKUP_STAGE_ROOT=/mnt/agenda-backup-stage
# So preencher com "confirmed" depois de verificar e registrar que o ponto acima e
# realmente cifrado. Deixar vazio faz o script recusar a execucao.
BACKUP_STAGE_ENCRYPTION_ATTESTATION=

# Caminho do clone em producao, contendo docker-compose.yml e ../.env.
AGENDA_INFRA_DIR=/opt/projeto_agenda/infra

# Arquivo privado fora do repositorio (chmod 600), contendo apenas a URL/caminho do
# repositorio Restic. A senha nao e persistida no servidor no modo manual.
RESTIC_REPOSITORY_FILE=/etc/agenda-backup/restic-repository

# Imagem ja baixada no host, usada apenas para arquivar o volume somente-leitura.
# Fixa a versao para evitar surpresa de tag durante uma janela de backup.
BACKUP_TAR_IMAGE=agenda-frontend:current

# Limites para operacao em hardware restrito. Se o Restic expirar, o servico e
# religado pelo trap e o estagio cifrado permanece para investigacao.
BACKUP_RESTIC_TIMEOUT_SECONDS=1200
BACKUP_HEALTH_TIMEOUT_SECONDS=120
BACKUP_IMAGE_TIMEOUT_SECONDS=1800

# Opcional: caminho do lock local. Nao use diretorio dentro do repositorio Restic.
BACKUP_LOCK_FILE=/run/lock/agenda-backup.lock
